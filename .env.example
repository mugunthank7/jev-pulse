# One OpenRouter key powers real Jev (typesafe/jev-1.13) AND the Claude/Gemini model race.
# https://openrouter.ai/settings/keys. New accounts need credits ($5 is plenty) for the pricier models.
OPENROUTER_API_KEY=

# jev | mock. Default: jev when OPENROUTER_API_KEY is set, otherwise the offline mock.
# JEV_BACKEND=jev

# Optional: raises the GitHub rate limit for `npm run dataset` and live repo scans.
GITHUB_TOKEN=

# Optional race tuning
# RACE_MODELS=anthropic/claude-haiku-4.5=Haiku,google/gemini-3.8-flash=Flash
# RACE_MIN_INTERVAL_MS=3200
PORT=8787
