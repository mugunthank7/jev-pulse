# mock (default, no key needed) | jev | kev
JEV_BACKEND=mock
# Real Jev (TypeSafe AI, early access): https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
# Any Jev-compatible endpoint (e.g. a self-hosted Kev)
KEV_URL=
PORT=8787

# Optional: real, measured Claude/Gemini numbers in the Model Race.
# Without keys those rows are shown as "modeled" estimates and clearly labelled.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Override if Google renames models:
GEMINI_FAST_MODEL=
GEMINI_PRO_MODEL=
