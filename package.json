{
  "name": "jev-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @jev-pulse/api\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "test": "vitest run",
    "typecheck": "tsc -p apps/api --noEmit && tsc -b apps/web",
    "dataset": "tsx scripts/build-dataset.ts",
    "dataset:search": "python3 scripts/build_search_dataset.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  }
}